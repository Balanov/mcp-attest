{
  "version": 1,
  "default_decision": "deny",
  "clients": {
    "alice": {
      "tools": {
        "allow": ["list_orders", "get_order"],
        "deny": ["refund_order"]
      },
      "identity": {
        "headers": { "Authorization": "Bearer ${ALICE_TOKEN}" }
      }
    },
    "lead": {
      "tools": {
        "allow": ["list_orders", "get_order", "refund_order"],
        "deny": []
      },
      "identity": {
        "headers": { "Authorization": "Bearer ${LEAD_TOKEN}" }
      }
    }
  },
  "cases": [
    {
      "id": "AUTHZ-CROSS-01",
      "identity": "alice",
      "tool": "get_order",
      "args": { "order_id": "B-77" },
      "expect": "deny",
      "reason": "order B-77 belongs to bob, not to alice"
    }
  ],
  "probes": {
    "get_order": { "order_id": "A-1" },
    "refund_order": { "order_id": "A-1", "amount": 10 }
  },
  "oauth": {
    "issuer": "https://auth.example.com/",
    "audience": "mcp://orders",
    "signing_key_env": "MCP_ATTEST_OAUTH_KEY",
    "authorization_endpoint": "http://127.0.0.1:8931/authorize",
    "redirect_uri": "http://127.0.0.1:8931/callback",
    "resource": "http://127.0.0.1:8931/mcp",
    "upstream": "http://127.0.0.1:8932/mcp",
    "required_scopes": {
      "list_orders": "orders:read",
      "get_order": "orders:read",
      "refund_order": "orders:write"
    }
  },
  "gateway": {
    "mode": "routed",
    "fail_closed": true,
    "passthrough_credentials": false
  },
  "receipts": {
    "required": true,
    "key_env": "MCP_ATTEST_KEY"
  }
}
